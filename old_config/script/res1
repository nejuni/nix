#!/bin/bash
set -euo pipefail

CONFIG_FILE="$HOME/.local/conf/restic/repos.conf"
LOG_DIR="$HOME/log/restic"
mkdir -p "$LOG_DIR"

for cmd in restic rg jq gum rclone; do
    command -v "$cmd" >/dev/null || { echo "$cmd not installed"; exit 1; }
done

PROFILE="$1"; shift

REPO=$(rg -A3 "^\[$PROFILE\]" "$CONFIG_FILE" | rg '^repository=' | cut -d= -f2)
PASS_FILE=$(rg -A3 "^\[$PROFILE\]" "$CONFIG_FILE" | rg '^password_file=' | cut -d= -f2)
PASS_FILE="${PASS_FILE/#\~/$HOME}"

[[ -z "$REPO" || -z "$PASS_FILE" ]] && { echo "Profile error"; exit 1; }

# Detect rclone remote and path
if [[ "$REPO" =~ ^rclone:([^:]+):(.*)/?$ ]]; then
    REMOTE="${BASH_REMATCH[1]}"
    FOLDER="${BASH_REMATCH[2]}"
else
    REMOTE=""
fi

# Start rclone REST server if needed
if [[ -n "$REMOTE" ]]; then
    gum style --foreground 212 "Starting rclone REST for $REMOTE..."

    # ✅ rclone throttle variables (VERY IMPORTANT)
    export RCLONE_DRIVE_DISABLE_HTTP2=true
    export RCLONE_DRIVE_CHUNK_SIZE=8M
    export RCLONE_TPSLIMIT=2
    export RCLONE_TPSLIMIT_BURST=1
    export RCLONE_TRANSFERS=1
    export RCLONE_CHECKERS=2

    rclone serve restic "$REMOTE": --addr 127.0.0.1:8000 >/dev/null 2>&1 &
    RCLONE_PID=$!

    sleep 2

    export RESTIC_REPOSITORY="rest:http://127.0.0.1:8000/$FOLDER"
else
    export RESTIC_REPOSITORY="$REPO"
fi

export RESTIC_PASSWORD_FILE="$PASS_FILE"

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG_FILE="$LOG_DIR/${PROFILE}_${TIMESTAMP}.log"

gum style --foreground 212 "Profile: $PROFILE"
gum style --foreground 109 "Repo: $RESTIC_REPOSITORY"
echo ""

restic "$@" 2>&1 | tee "$LOG_FILE"
EXIT_CODE=${PIPESTATUS[0]}

if [[ -n "${RCLONE_PID:-}" ]]; then
    kill "$RCLONE_PID" 2>/dev/null || true
fi

echo ""
[[ $EXIT_CODE -eq 0 ]] && gum style --foreground 114 "Success" || gum style --foreground 196 "Failed"

exit $EXIT_CODE