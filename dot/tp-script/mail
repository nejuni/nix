#!/usr/bin/env python3

# Google mail run by ~/.config/isyncrc mbsync -a

"""
mailserver.py — optimized single-file notmuch/mbsync webmail

Speed changes vs the original 3-part version:
  1. CSS/JS served from cached, immutable static routes instead of being
     re-embedded in every HTML response (biggest win on mobile data).
  2. extract_body() + list_attachments() merged into one msg.walk() pass.
  3. discover_accounts() cached in memory, invalidated after a sync.
  4. Marking messages read is now ONE batched `notmuch tag` call per
     thread view instead of one subprocess spawn per message.
  5. gzip compression on text responses via after_request.
  6. Meant to run under waitress (see bottom) instead of the Flask
     dev server — multi-threaded, no reloader overhead, works fine
     in Termux/proot with plain pip, no compiler needed.

Run:
    pip install flask waitress
    python mailserver.py
"""

import base64
import gzip
import io
import json
import os
import re
import subprocess
import threading
import time
from pathlib import Path

from email import message_from_binary_file, policy
from email.utils import getaddresses
from flask import Flask, Response, abort, request

# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------

MAIL_ROOT = Path(os.environ.get("MAIL_ROOT", Path.home() / "Mail"))
NOTMUCH = os.environ.get("NOTMUCH_BIN", "notmuch")
MBSYNC = os.environ.get("MBSYNC_BIN", "mbsync")
HOST = os.environ.get("HOST", "127.0.0.1")
PORT = int(os.environ.get("PORT", "8080"))
ACCOUNTS_TTL = 30  # seconds — how long the account list is trusted

app = Flask(__name__)

_sync_lock = threading.Lock()
_sync_state = {"running": False, "ok": None, "log": ""}

# ----------------------------------------------------------------------
# Account discovery (cached)
# ----------------------------------------------------------------------

_accounts_cache = {"data": [], "ts": 0.0}


def discover_accounts(force=False):
    now = time.time()
    if not force and (now - _accounts_cache["ts"]) < ACCOUNTS_TTL:
        return _accounts_cache["data"]

    data = []
    if MAIL_ROOT.exists():
        data = sorted(p.name for p in MAIL_ROOT.iterdir() if p.is_dir())

    _accounts_cache["data"] = data
    _accounts_cache["ts"] = now
    return data


# ----------------------------------------------------------------------
# notmuch helpers
# ----------------------------------------------------------------------

def nm_run(*args):
    result = subprocess.run([NOTMUCH, *args], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "notmuch command failed")
    return result.stdout


def nm_json(*args):
    return json.loads(nm_run(*args))


# ----------------------------------------------------------------------
# Sync helpers
# ----------------------------------------------------------------------

def run_sync():
    with _sync_lock:
        if _sync_state["running"]:
            return
        _sync_state.update(running=True, ok=None, log="")

    def worker():
        ok = False
        log = ""
        try:
            proc = subprocess.run(
                [MBSYNC, "-a"], capture_output=True, text=True, timeout=1800
            )
            log += proc.stdout + proc.stderr
            ok = proc.returncode == 0
            if ok:
                try:
                    log += "\n" + nm_run("new")
                except Exception as e:
                    log += f"\nnotmuch new failed: {e}"
        except Exception as e:
            log = str(e)

        _sync_state.update(running=False, ok=ok, log=log)
        # accounts / folder layout may have changed — refresh cache
        discover_accounts(force=True)

    threading.Thread(target=worker, daemon=True).start()


# ----------------------------------------------------------------------
# HTML sanitization
# ----------------------------------------------------------------------

SCRIPT_RE = re.compile(r"<script\b.*?</script>", re.I | re.S)
EVENT_RE = re.compile(r'\s+on\w+\s*=\s*(".*?"|\'.*?\'|[^\s>]+)', re.I)
META_REFRESH_RE = re.compile(r'<meta[^>]+http-equiv=["\']?refresh["\']?[^>]*>', re.I)


def sanitize_html(html):
    html = SCRIPT_RE.sub("", html)
    html = EVENT_RE.sub("", html)
    html = META_REFRESH_RE.sub("", html)
    html = re.sub(r"javascript\s*:", "removed:", html, flags=re.I)
    return html


# ----------------------------------------------------------------------
# Message loading
# ----------------------------------------------------------------------

def _find_file(message_id):
    files = nm_run("search", "--output=files", f"id:{message_id}").splitlines()
    if not files:
        abort(404)
    return files[0]


def load_message(message_id):
    with open(_find_file(message_id), "rb") as fp:
        return message_from_binary_file(fp, policy=policy.default)


def recipient_email(msg):
    addrs = getaddresses(msg.get_all("To", []))
    return addrs[0][1] if addrs else ""


def sender_full(msg):
    return msg.get("From", "")


# ----------------------------------------------------------------------
# Single-pass body + attachment extraction
# (was two separate msg.walk() calls — now one)
# ----------------------------------------------------------------------

def extract_body_and_attachments(msg):
    html = None
    text = None
    cid = {}
    attachments = []

    for idx, part in enumerate(msg.walk()):
        if part.is_multipart():
            continue

        ctype = part.get_content_type()
        content_id = (part.get("Content-ID", "") or "").strip("<>")

        if content_id:
            try:
                cid[content_id] = (ctype, part.get_payload(decode=True))
            except Exception:
                pass

        disp = (part.get("Content-Disposition") or "").lower()
        name = part.get_filename()
        if name or "attachment" in disp:
            attachments.append((idx, name or f"attachment-{idx}", ctype))
            # an attachment part is never the html/text body — skip below
            continue

        if ctype == "text/html" and html is None:
            try:
                html = part.get_content()
            except Exception:
                pass
        elif ctype == "text/plain" and text is None:
            try:
                text = part.get_content()
            except Exception:
                pass

    if html:
        def repl(match):
            key = match.group(1)
            if key not in cid:
                return match.group(0)
            mime, payload = cid[key]
            return 'src="data:%s;base64,%s"' % (mime, base64.b64encode(payload).decode())

        html = re.sub(r'src=["\']cid:([^"\']+)["\']', repl, html)
        body = (sanitize_html(html), "html")
    elif text:
        text = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        body = (
            "<pre style='white-space:pre-wrap;font-family:inherit'>" + text + "</pre>",
            "text",
        )
    else:
        body = ("<i>(No readable body)</i>", "text")

    return body, attachments


