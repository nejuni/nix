@app.route("/static/app.css")
def static_css():
    resp = Response(BASE_CSS, mimetype="text/css")
    resp.headers["Cache-Control"] = "public, max-age=31536000, immutable"
    return resp


@app.route("/static/app.js")
def static_js():
    resp = Response(PAGE_JS, mimetype="application/javascript")
    resp.headers["Cache-Control"] = "public, max-age=31536000, immutable"
    return resp


def html_attr_escape(text: str) -> str:
    return text.replace("&", "&amp;").replace('"', "&quot;")


def page(title, body, accounts):
    account_links = [
        '<a href="/search?q=tag:inbox">📥 All Inbox</a>',
        '<a href="/search?q=tag:unread">📬 Unread</a>',
    ]
    for acct in accounts:
        account_links.append(f'<a href="/search?q=folder:{acct}/INBOX">{acct}</a>')

    q = html_attr_escape(request.args.get("q", ""))

    return f"""<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
<header>
<div class="top">
<form class="search" action="/search">
<input name="q" placeholder="Search mail..." value="{q}">
</form>
<button type="button" onclick="menu()">☰</button>
</div>
<div class="toolbar">
<button onclick="syncNow()">Sync</button>
<a class="btn secondary" href="/search?q=tag:inbox">Inbox</a>
<a class="btn secondary" href="/search?q=tag:unread">Unread</a>
<small id="sync"></small>
</div>
</header>
<div id="drawer" class="drawer" onclick="menu()">
<nav onclick="event.stopPropagation()">
{"".join(account_links)}
</nav>
</div>
<main>
{body}
</main>
<script src="/static/app.js"></script>
</body>
</html>
"""


# ----------------------------------------------------------------------
# Routes
# ----------------------------------------------------------------------

@app.route("/")
def index():
    return search_impl("tag:inbox", discover_accounts())


@app.route("/search")
def search():
    return search_impl(request.args.get("q", "tag:inbox"), discover_accounts())


def search_impl(query, accounts):
    try:
        threads = nm_json("search", "--format=json", "--limit=200", query)
    except Exception as e:
        return page("Mail", f"<p>{e}</p>", accounts)

    rows = [
        f"""
<a class="thread {'unread' if 'unread' in t.get('tags', []) else ''}"
href="/thread/{t['thread']}">
<div class="author">{t.get('authors', '')}</div>
<div class="subject">{t.get('subject') or '(no subject)'}</div>
<div class="date">{t.get('date_relative', '')}</div>
</a>
"""
        for t in threads
    ]

    body = (
        f"<p><small>{len(threads)} results for <code>{query}</code></small></p>"
        + ("".join(rows) or "<p>No mail found.</p>")
    )
    return page("Mail", body, accounts)


@app.route("/thread/<thread_id>")
def thread_view(thread_id):
    accounts = discover_accounts()

    try:
        tree = nm_json("show", "--format=json", "--body=false", f"thread:{thread_id}")
    except Exception as e:
        return page("Thread", f"<p>{e}</p>", accounts)

    ids = []

    def walk(nodes):
        for n in nodes:
            if isinstance(n, list):
                walk(n)
            elif isinstance(n, dict):
                ids.append(n["id"])
                walk(n.get("replies") or [])

    walk(tree)

    html_parts = []

    for mid in ids:
        try:
            msg = load_message(mid)
        except Exception as e:
            html_parts.append(f"<p>{e}</p>")
            continue

        (body, _), files = extract_body_and_attachments(msg)

        attach = ""
        if files:
            chips = "".join(
                f'<a href="/message/{mid}/attachment/{i}">📎 {name}</a>'
                for i, name, _ in files
            )
            attach = f'<div class="attach">{chips}</div>'

        html_parts.append(f"""
<div class="msg">
<div class="msghdr">
<h3 style="margin:0">{msg.get("Subject", "(no subject)")}</h3>
<small>
<b>To</b><br>{recipient_email(msg)}
<br><br>
<b>From</b><br>{sender_full(msg)}
<br><br>
<b>Date</b><br>{msg.get("Date", "")}
</small>
</div>
<div class="msgbody">
<iframe sandbox="allow-same-origin" onload="fitFrame(this)" srcdoc="{html_attr_escape(body)}"></iframe>
</div>
{attach}
</div>
""")

    # Batched: one notmuch call for the whole thread instead of one per message
    if ids:
        try:
            id_query = " or ".join(f"id:{mid}" for mid in ids)
            nm_run("tag", "-unread", "--", f"({id_query})")
        except Exception:
            pass

    return page("Thread", "".join(html_parts), accounts)


@app.route("/message/<mid>/attachment/<int:index>")
def attachment(mid, index):
    msg = load_message(mid)
    parts = list(msg.walk())
    if index >= len(parts):
        abort(404)
    part = parts[index]
    data = part.get_payload(decode=True)
    if data is None:
        abort(404)
    return Response(
        data,
        mimetype=part.get_content_type(),
        headers={
            "Content-Disposition": f'attachment; filename="{part.get_filename() or "attachment"}"'
        },
    )


@app.route("/sync", methods=["POST"])
def sync():
    run_sync()
    return {"started": True}


@app.route("/sync/status")
def sync_status():
    return {"running": _sync_state["running"], "ok": _sync_state["ok"]}


# ----------------------------------------------------------------------
# gzip compression for text responses
# ----------------------------------------------------------------------

@app.after_request
def compress(resp):
    accept_enc = request.headers.get("Accept-Encoding", "")
    if (
        "gzip" not in accept_enc
        or resp.direct_passthrough
        or resp.content_length is not None
        and resp.content_length < 500
        or "text" not in (resp.mimetype or "")
        and "javascript" not in (resp.mimetype or "")
        and "json" not in (resp.mimetype or "")
    ):
        return resp

    buf = io.BytesIO()
    with gzip.GzipFile(mode="wb", fileobj=buf, compresslevel=6) as gz:
        gz.write(resp.get_data())
    resp.set_data(buf.getvalue())
    resp.headers["Content-Encoding"] = "gzip"
    resp.headers["Content-Length"] = str(len(resp.get_data()))
    return resp


# ----------------------------------------------------------------------
# Entry point
# ----------------------------------------------------------------------

if __name__ == "__main__":
    print("Accounts:", discover_accounts(force=True))

    try:
        from waitress import serve
        # threads: a few workers is plenty for a single-user mail UI,
        # and keeps memory low on-device
        serve(app, host=HOST, port=PORT, threads=4)
    except ImportError:
        print("waitress not installed — falling back to Flask dev server.")
        print("For real speed, run: pip install waitress")
        app.run(host=HOST, port=PORT, debug=False, threaded=True)

